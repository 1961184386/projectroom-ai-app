# Database
DATABASE_URL=postgresql://projectroom:projectroom@localhost:5432/projectroom
# SQLite fallback (no Docker needed):
# DATABASE_URL=sqlite:///./projectroom.db

# AI Provider — OpenAI compatible
# Standard OpenAI:
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Volcano Engine ARK (火山云):
# OPENAI_API_KEY=ark-your-key-here
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=doubao-pro-32k

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000
