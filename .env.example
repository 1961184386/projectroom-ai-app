# Database
DATABASE_URL=postgresql://projectroom:projectroom@localhost:5432/projectroom
# SQLite fallback (no Docker needed):
# DATABASE_URL=sqlite:///./projectroom.db

# AI Provider — OpenAI compatible
# Standard OpenAI:
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Volcano Engine ARK (火山云):
# OPENAI_API_KEY=ark-your-key-here
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL=doubao-pro-32k

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Public base URL for webhook callbacks in local tunneling setups
WEBHOOK_PUBLIC_BASE_URL=

# Tencent Meeting Integration
TENCENT_MEETING_API_MODE=mock
TENCENT_MEETING_APP_ID=
TENCENT_MEETING_CORP_ID=
TENCENT_MEETING_SECRET_ID=
TENCENT_MEETING_SECRET_KEY=
TENCENT_MEETING_SDK_ID=
TENCENT_MEETING_AUTH_MODE=enterprise_jwt
TENCENT_MEETING_WEBHOOK_TOKEN=
TENCENT_MEETING_WEBHOOK_URL=

# DingTalk Integration
DINGTALK_API_MODE=mock
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_WEBHOOK_TOKEN=
DINGTALK_WEBHOOK_URL=
